{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Raylib",
            "type": "shell",
            "command": "gcc",
            "args": [
                "src/*.c",
                "-Iinclude",
                "-o",
                "bin/jogo",
                "-lraylib",
                "-lGL",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}